{
  "schema_version": 1,
  "skill": "slides-style",
  "cases": [
    {
      "id": "review-decks",
      "description": "Starter coverage: house-rule and alignment review of three Claude Slides decks given as files: one compliant with every house exception, one breaking six house rules, one breaking chrome, title and alignment rules; not building, publishing or visual judgement.",
      "prompt": "review-decks/prompt.md",
      "inputs": "review-decks/input",
      "reference": "review-decks/reference",
      "capabilities": [
        "filesystem"
      ],
      "tags": [
        "starter",
        "offline"
      ],
      "timeout_s": 180,
      "checks": [
        {
          "id": "a",
          "kind": "json_equals",
          "dimension": "task_success",
          "critical": true,
          "pointer": "/A",
          "expected": []
        },
        {
          "id": "b",
          "kind": "json_equals",
          "dimension": "task_success",
          "critical": true,
          "pointer": "/B",
          "expected": [
            "bullets",
            "font",
            "notes",
            "placeholder",
            "text-size",
            "title-bold"
          ]
        },
        {
          "id": "c",
          "kind": "json_equals",
          "dimension": "task_success",
          "critical": true,
          "pointer": "/C",
          "expected": [
            "chrome",
            "drift",
            "near-miss",
            "title-period"
          ]
        }
      ]
    }
  ]
}
